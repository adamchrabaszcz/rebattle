// Cloudflare Workers deploy: the app is static assets from public/ (docs, tests and
// tools are never published); worker/ handles /api/* only.
{
  "name": "rebattle",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    // /t/<code>, /manage/<code> and other app paths get index.html; the app routes them.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Access for organisers (/manage/*, /api/manage/*). Not secrets: the team
  // domain is public and the AUD tag only identifies this app. Locally, .dev.vars can
  // set DEV_ORGANISER_EMAIL instead (see worker/auth.js).
  "vars": {
    // Changing the team name in Zero Trust changes this domain (and the token issuer).
    "ACCESS_TEAM_DOMAIN": "https://silent-paper-2aa5.cloudflareaccess.com",
    "ACCESS_AUD": "efaef521e782085d4fcfddd0db011ece190fa12519c5e1e1fff24158159939fa"
  },
  // Pull requests get a preview URL (`npx wrangler preview`); settings are inherited.
  "previews": {}
}
